  {
   "severity": "medium",
   "title": "Wall between L75 and L99/L100: no human-model tier clears them",
   "detail": "World and skilled clear L1–L75 on the first try (L75 in 23 s / 47 s) but all 6 attempts on L99 and L100 end in timeouts (no gap they trust in 75 s) or collisions; superhuman clears them only by tight packing with ≤±25 ms timing. Offline core sim of a perfect-information packer: success 10/10 with ±20 ms timing, but only 1/10 (L99) and 8/10 (L100) with ±35 ms. L99 is a non-boss level yet has 8 pre-placed knives (preN = floor((L+5)/13), index.html levelConfig) plus 13 to throw at erratic w0 ≈ 4.8 rad/s with holds of ~0.5 s.",
   "repro": "node qa/skill-tiers/knife-target/bot.js world 75,99,100",
   "fix": "Cap pre-placed knives on non-boss levels (e.g. preN = min(5, …)) or soften erratic holds after L80 (hMin = 1.05·0.988^k → floor at ~0.8 s) so L99/L100 stay within a world-class human’s ±12 ms."
  },
  {
   "severity": "low",
   "title": "A tap during the 0.1 s knife flight is dropped, while a tap during hit-stop is buffered",
   "detail": "requestThrow() returns early when r.flying (index.html:757) so a quick second tap is lost silently; a tap during the 45 ms hit-stop is kept in G.pendingThrow and fires later. Inconsistent feel for fast tappers; no double count observed.",
   "repro": "Tap twice 60 ms apart on L1: only one knife is thrown.",
   "fix": "Buffer one tap while flying (store pendingThrow and consume it when flying ends), or ignore taps during hit-stop too."
  }

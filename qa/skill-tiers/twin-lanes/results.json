 "findings": [
  {
   "severity": "medium",
   "title": "Near-miss (驚險) bonus can be farmed on every hazard — doubles the score",
   "detail": "resolve() gives +3 instead of +1 whenever the runner left the hazard lane < 0.2 s before impact (index.html:496), with no cooldown, and it feeds combo/multiplier. A frame-accurate player who parks in the hazard lane and hops out at the last moment scored 6752 in 150 s versus 3573 for the same superhuman on the same seed (9000) without farming (+89%), and 3–4× the best world-class run (1703).",
   "repro": "node qa/skill-tiers/twin-lanes/bot.js superhuman 1  vs  NOFARM=1 node qa/skill-tiers/twin-lanes/bot.js superhuman 1",
   "fix": "Only award 驚險 when the previous row forced the runner into that lane (r.prevLane was the required lane of the last resolved row), or add a cooldown / cap per N rows."
  },
  {
   "severity": "low",
   "title": "Every mistake is fatal from the first second — very steep for casual players",
   "detail": "Median survival: clumsy 3.7 s (score 3), casual 8.3 s (15), skilled 35 s (250), world 80 s (1465), superhuman 150 s cap (6724). The first row reaches the runners ~2 s after 開始 while the help labels are still shown; 3/5 clumsy runs ended at the first or second row.",
   "repro": "node qa/skill-tiers/twin-lanes/bot.js casual",
   "fix": "Optional: start with a few coin-only rows on the runners’ current lanes (or a 3-s grace without hazards), or one shield/second chance per run."
  }
 ],

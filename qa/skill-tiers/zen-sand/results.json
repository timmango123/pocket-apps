 "findings": [
  {
   "severity": "high",
   "title": "工具按鈕在耙完一筆後立刻點，約 1/7 的點擊被吞掉",
   "detail": "pointerdown/pointerup 都送到按鈕上，但 Chromium 沒產生 click。初跑世界級（4px 誤差）點「耙沙」落空一次，非人（0 誤差）點「擺放」落空一次；壓力測試 40 次「耙一筆→點擺放→點耙沙」掉 6 次。",
   "repro": "node <scratch>/tapmiss.js：耙一筆後 0 ms 內點 #mPlace，120 ms 後 mode 仍是 rake",
   "status": "fixed"
  },
  {
   "severity": "medium",
   "title": "石頭底下的沙也被耙出紋路",
   "detail": "繞石耙圈後，石頭本體下方 51–85% 取樣點高度不為 0（放石頭只把周圍抹平，耙子的偏折沒有保護本體）。",
   "repro": "放石頭→用三齒耙繞一圈→讀 heightAt(石頭中心±0.5s)",
   "status": "fixed (previous worker)"
  },
  {
   "severity": "medium",
   "title": "旋轉或換螢幕尺寸後，物件可能卡在工具列或標題底下",
   "detail": "物件用比例座標存，直式放在工具列上方的石頭轉成橫式後中心落在工具列下 9 px，幾乎點不到也拖不出來；在別的尺寸存檔再打開也一樣。",
   "repro": "直式在工具列上方 14 px 放石頭→setViewportSize(844x390)",
   "status": "fixed"
  },
  {
   "severity": "low",
   "title": "兩隻手指同時拖兩個物件，第一個會被丟下",
   "detail": "拖曳狀態只有一個全域變數，第二指覆蓋第一指；第一顆石頭停在半路、沒有壓平底下的沙。",
   "repro": "放兩顆石頭，兩指同時各拖一顆",
   "status": "fixed"
  },
  {
   "severity": "low",
   "title": "（測試誤判，已撤回）多指耙沙掉一指",
   "detail": "初跑時在預定行而不是手指實際走過的行判定；改判定後原版也是 100/100，另做 60 條 2–3 指同時耙線壓力測試，原版與新版都 0 遺漏。",
   "repro": "-",
   "status": "not a game bug"
  },
  {
   "severity": "low",
   "title": "無頭瀏覽器幀間隔偶有 100–380 ms 尖峰",
   "detail": "JS 繪圖每幀平均 <1 ms、p95 <2 ms，CPU profile 幾乎全是 idle/點陣化；尖峰來自共用 4 核心機器負載 16–20。原版在同一 bot 下 p95 58–67 ms，現版 17–33 ms（靜態圖層已快取）。",
   "repro": "-",
   "status": "environment; noted"
  }
 ],

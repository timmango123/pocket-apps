 "findings": [
  {
   "severity": "medium",
   "title": "First build: skill barely changed the outcome (luck-dominated)",
   "detail": "Before the one-die option, even a bot that knows every future dice roll only won 52-56% vs 普通 and 48% vs 高手; buy/build/jail choices are too weak a lever in a 4-player dice game.",
   "repro": "node bot.js --sim 200 on the build before 只擲一顆",
   "status": "fixed: added 只擲一顆 (move by one die, no doubles, same dice stream) — superhuman now 97-99%"
  },
  {
   "severity": "medium",
   "title": "world tier (rollout search) scored below skilled heuristic",
   "detail": "The 高手 brain used 8-16 random-dice rollouts per decision; noise made it worse than the plain heuristic (23% vs 32.5% wins vs 普通) and cost up to ~200 ms per decision under load.",
   "repro": "node bot.js --sim 200 (earlier build)",
   "status": "fixed: replaced with an aggressive heuristic plus two-turn dice lookahead, tuned on 1200-game samples; avg think 0.3 ms"
  },
  {
   "severity": "low",
   "title": "高手 and 普通 computers played almost alike",
   "detail": "Heuristic player won 26% vs 普通 and 24-27% vs 高手.",
   "repro": "demo/tests.js difficulty block",
   "status": "fixed: 高手 uses the stronger brain and starts with +$2,000 (stated in the menu); heuristic player now 48/26/20%"
  },
  {
   "severity": "low",
   "title": "No dropped or doubled taps, no page/console errors",
   "detail": "7 real-browser games (CDP touch, tier reaction times and aim error): 0 taps on target without effect, 2 clumsy off-target taps, 0 errors, all games reached the result screen.",
   "repro": "node bot.js --browser",
   "status": "ok"
  }
 ],

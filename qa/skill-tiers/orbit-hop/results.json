 "findings": [
  {
   "severity": "medium",
   "title": "Planet generation stalls frames for up to ~90 ms in late game, delaying launches",
   "detail": "update() calls genPlanet(world,5) every frame (index.html:444) but the 5 ms budget is only checked before starting a new try (index.html:232); one try runs measureWindow (6 arrival samples × ~560 phases × full flight sim for moving/black-hole planets). __game.genStats(90,1001) on this machine: per-try cost median 2.5 ms, p90 14.5 ms, max 87.5 ms; 17 of 90 planets took >16 ms (max 145 ms). A tap that lands during such a frame is handled after it and the launch happens late by the stall. Fatal launches of skilled/world runs were 118–268 ms late against windows of 200–330 ms while their normal launches averaged ~20–25 ms — consistent with such stalls (touch-delivery spikes on the shared test machine also contribute). On phones (3–5× slower CPU) the stalls would be several frames long.",
   "repro": "In DevTools: __game.genStats(90,1001).out.filter(p=>p.ms>16)  → 17 planets, max ≈145 ms; play past planet ~35 and watch the frame graph.",
   "fix": "Check the deadline inside measureWindow (pass tStart+budget and abort/resume the scan), or generate planets ahead during the title / in a Worker, or cache simLaunch results; never run an unbudgeted try inside a frame."
  },
  {
   "severity": "low",
   "title": "Test hook botPlan truncates windows already in progress, and demo/bot.js sleeps from a stale clock",
   "detail": "botPlan scans from tau=max(0,tmin−1) (index.html:593) so a window that began before the snapshot is cut and its centre drifts late; demo/bot.js then sleeps plan.wall−plan.now−comp after the re-planning loop, using a plan.now that is up to 120 ms stale, and accepts plans computed from a snapshot of the previous planet. Together these produced impossible-looking deaths (taps in flight, launches 1 s early) in a first pass of this QA run. QA tooling only; players are not affected.",
   "repro": "node apps/orbit-hop/demo/bot.js 5 25 400  → several ‘lost in space’ deaths at wide windows",
   "fix": "Scan from tau=−1 when the snapshot is in orbit on the same planet; in demo/bot.js compute the sleep from the current page time and drop plans whose pi differs from the live state."
  }
 ],
 "method": {
  "input": "real CDP touch on the canvas per launch; runs started with __game.start(seed) (seeds 1000–1004, same worlds for all tiers)",
  "planning": "apps/orbit-hop/demo/bot.js approach: window.__game.botPlan(delay) (read-only, exact physics from a delayed snapshot) gives the next launch window; the tier aims at its centre with timing σ; mistake = ±400 ms, clumsy 50%/casual 15% unaimed ±150 ms. Two bugs of the demo approach fixed in this bot: plans for the previous planet are ignored, and the tap time is computed on an absolute page clock (demo slept relative to a stale plan.now). Snapshot age = max(reaction, 700 ms) so windows already in progress are not truncated.",
  "caps": "80 jumps or 240 s per run; 5 runs (world/superhuman 3)",
  "diagnostics": "page-side pointerdown/launch log kept for each fatal launch (fatalTap/diag)"
 },

+/* ================= online play ================= */
+var NETST = '';
+function netReplay(mv) { // silent replay of a received move list; returns how many were legal
+  for (var i = 0; i < mv.length; i++) {
+    var p = mv[i], c = G.toMove;
+    if (G.over || typeof p !== 'number' || p !== (p | 0) || p < 0 || p >= NN || B[p]) return i;
+    var forb = G.rule === 2 && c === 1 && !isFive(p, 1) && isForbidden(p), ftype = forb ? fbType(p) : '';
+    play(p, c); G.moves.push([p, c]); G.toMove = 3 - c;
+    var wl = winLine(p);
+    if (wl) { G.wl = wl; winT = now() - 5000; G.over = true; G.result = { winner: c, reason: '連成五子' }; }
+    else if (forb) { G.over = true; G.result = { winner: 3 - c, reason: '黑方禁手（' + ftype + '）' }; }
+    else if (STONES >= NN) { G.over = true; G.result = { winner: 0, reason: '棋盤下滿' }; }
+  }
+  return mv.length;
+}
+NET.init({
+  game: 'gomoku', title: '五子棋', sides: ['黑', '白'], button: $('tNet'),
+  choices: [{ key: 'rule', label: '規則', def: 0, items: [[0, '自由'], [1, '標準'], [2, '連珠']] }, { key: 'size', label: '盤面', def: 15, items: [[9, '9 路'], [15, '15 路'], [19, '19 路']] }],
+  start: function (o, side, mv) {
+    hideAllOv();
+    startGame({ mode: 'net', size: o.size, rule: o.rule, tengen: false });
+    var n = netReplay(mv);
+    computeFb(); computeThreats(); labelChips(); updateUI(); kick();
+    if (G.over) setTimeout(function () { if (G.mode === 'net' && G.over) showResult(); }, 400);
+    return n;
+  },
+  play: function (p) {
+    if (G.mode !== 'net' || G.over || typeof p !== 'number' || p !== (p | 0) || p < 0 || p >= NN || B[p]) return false;
+    preview = -1; hover = -1; hideMag();
+    doMove(p, G.toMove, false); return true;
+  },
+  toMove: function () { return G.mode !== 'net' || G.over ? -1 : G.toMove - 1; },
+  resigned: function (side) { if (G.mode !== 'net' || G.over) return; G.token++; finish(2 - side, colName(side + 1) + '方認輸'); },
+  exit: function () { G.mode = 'none'; showScreen('scrTitle'); },
+  names: function (a, b) { G.netNames = [a, b]; if (G.mode === 'net') labelChips(); },
+  onStatus: function (t) { NETST = t; if (G.mode === 'net') updateStatus(); },
+  resumeHint: function (code) { $('tNetInfo').textContent = '房間 ' + code; },
+  snapshot: function () { return G.size + ':' + G.moves.map(function (m) { return m[0]; }).join(',') + '|' + (G.over && G.result ? G.result.winner : '-'); },
+  randomMove: function () {
+    var c = G.toMove, ok = [];
+    for (var q = 0; q < NN; q++) if (!B[q] && legal(q, c)) ok.push(q);
+    if (!ok.length) return false;
+    tryPlace(ok[(Math.random() * ok.length) | 0], false); return true;
+  }
+});
 